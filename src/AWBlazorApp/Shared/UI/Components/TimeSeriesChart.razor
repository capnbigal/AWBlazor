@* Reusable time-series chart with period presets and granularity controls.
   Wraps MudChart and provides consistent period-selector UX across all analytics pages.
   CSV export uses a server-side Minimal API endpoint — no JS required. *@
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Caching.Memory.IMemoryCache MemoryCache
@using MudBlazor.Charts

<MudPaper Class="pa-4" Elevation="2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" Spacing="2">
        <MudText Typo="Typo.h6">@Title</MudText>
        <MudSpacer />
        @if (FilteredLabels.Length > 0)
        {
            <MudTooltip Text="Download CSV">
                <MudIconButton Icon="@Icons.Material.Filled.Download" aria-label="Download" Size="Size.Small" Color="Color.Default"
                               Href="@ExportUrl" Target="_blank" />
            </MudTooltip>
        }
        @if (ShowGranularity)
        {
            <MudToggleGroup T="Granularity" @bind-Value="SelectedGranularity" Color="Color.Primary" Size="Size.Small"
                            SelectionMode="SelectionMode.SingleSelection">
                <MudToggleItem T="Granularity" Value="Granularity.Monthly" Text="Month" />
                <MudToggleItem T="Granularity" Value="Granularity.Quarterly" Text="Quarter" />
                <MudToggleItem T="Granularity" Value="Granularity.Yearly" Text="Year" />
            </MudToggleGroup>
        }
        <MudToggleGroup T="string" @bind-Value="SelectedPeriod" Color="Color.Primary" Size="Size.Small"
                        SelectionMode="SelectionMode.SingleSelection">
            @foreach (var p in Periods)
            {
                <MudToggleItem T="string" Value="@p" Text="@p" />
            }
        </MudToggleGroup>
    </MudStack>

    @if (Loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (FilteredLabels.Length == 0)
    {
        <MudAlert Severity="Severity.Info" Dense="true">No data for the selected period.</MudAlert>
    }
    else
    {
        <MudChart T="double"
                  ChartType="@ChartType"
                  ChartSeries="@FilteredSeries"
                  ChartLabels="@DisplayLabels"
                  Width="100%" Height="@Height"
                  ChartOptions="@Options" />
    }
</MudPaper>

@code {
    [Parameter] public string Title { get; set; } = "Chart";
    [Parameter] public ChartType ChartType { get; set; } = ChartType.Line;
    [Parameter] public string Height { get; set; } = "380px";
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool ShowGranularity { get; set; } = true;

    [Parameter] public string[] Labels { get; set; } = [];
    [Parameter] public List<ChartSeries<double>> Series { get; set; } = [];
    [Parameter] public string[] Periods { get; set; } = ["6M", "12M", "24M", "All"];
    [Parameter] public EventCallback<PeriodChangedArgs> OnPeriodChanged { get; set; }
    /// <summary>X-axis label rotation in degrees. Defaults to 35 — diagonal labels fit ~24 month
    /// names without overlap. Override per-call (set to 0) for charts with very few short labels.</summary>
    [Parameter] public int XAxisLabelRotation { get; set; } = 35;
    /// <summary>Optional pre-built chart options. When null, options are derived from ChartType + YAxisFormat.</summary>
    [Parameter] public IChartOptions? ChartOptions { get; set; }

    /// <summary>.NET format string applied to the Y-axis tick labels. Default is "N0" (thousands-separated integer).</summary>
    [Parameter] public string YAxisFormat { get; set; } = "N0";
    /// <summary>Optional custom Y-axis label formatter. Overrides <see cref="YAxisFormat"/>. Use for compact formats like $5.9M.</summary>
    [Parameter] public Func<double, string>? YAxisToStringFunc { get; set; }

    private string _selectedPeriod = "";
    private string SelectedPeriod
    {
        get => _selectedPeriod;
        set
        {
            if (_selectedPeriod == value) return;
            _selectedPeriod = value;
            _exportKey = null; // invalidate cached export
            _ = NotifyPeriodChanged();
        }
    }

    private Granularity _selectedGranularity = Granularity.Monthly;
    private Granularity SelectedGranularity
    {
        get => _selectedGranularity;
        set
        {
            if (_selectedGranularity == value) return;
            _selectedGranularity = value;
            _exportKey = null;
            _ = NotifyPeriodChanged();
        }
    }

    private IChartOptions Options
    {
        get
        {
            if (ChartOptions is not null)
                return ChartOptions;

            // Use chart-type-specific options so YAxisFormat / YAxisToStringFunc take effect.
            // Seed ChartPalette with the app-wide blue/slate scale so auto-assigned series
            // colors stay on-brand instead of falling back to MudBlazor's rainbow default.
            // XAxisLabelRotation is set to 35° by default — at 0° MudChart silently drops
            // overlapping x-axis labels, leaving the user without month/category context.
            // Diagonal labels fit ~24 month names side-by-side without collision.
            var palette = AWBlazorApp.Shared.Theming.ChartPalettes.BlueScale;
            return ChartType switch
            {
                // Line: do NOT force the y-axis through zero, so trends that vary in a narrow band
                // above 0 (scrap %, avg duration) use the full chart height instead of hugging the
                // bottom. Markers + a heavier stroke make individual points legible; cap y ticks.
                ChartType.Line       => new LineChartOptions       { YAxisFormat = YAxisFormat, YAxisToStringFunc = YAxisToStringFunc, ChartPalette = palette, XAxisLabelRotation = XAxisLabelRotation, YAxisRequireZeroPoint = false, MaxNumYAxisTicks = 6, LineStrokeWidth = 3, ShowDataMarkers = true },
                // Bar: keep a zero baseline (bars are read from 0) but cap the y-tick count.
                ChartType.Bar        => new BarChartOptions        { YAxisFormat = YAxisFormat, YAxisToStringFunc = YAxisToStringFunc, ChartPalette = palette, XAxisLabelRotation = XAxisLabelRotation, MaxNumYAxisTicks = 6 },
                ChartType.StackedBar => new StackedBarChartOptions { YAxisFormat = YAxisFormat, YAxisToStringFunc = YAxisToStringFunc, ChartPalette = palette, XAxisLabelRotation = XAxisLabelRotation },
                _                    => new ChartOptions            { ChartPalette = palette },
            };
        }
    }
    private string? _exportKey;

    private string ExportUrl
    {
        get
        {
            if (_exportKey is null)
            {
                var (labels, series) = GetFilteredRange();
                var exportSeries = series.Select(s =>
                    new AWBlazorApp.Shared.Api.ChartExportEndpoints.ChartExportSeries(s.Name, s.Data.ToArray())).ToList();
                _exportKey = AWBlazorApp.Shared.Api.ChartExportEndpoints.StoreForExport(
                    MemoryCache, Title, SelectedPeriod, labels, exportSeries);
            }
            return $"api/chart-export/{_exportKey}";
        }
    }

    protected override void OnInitialized()
    {
        if (Periods.Length > 0)
            _selectedPeriod = Periods[0];
    }

    private string[] FilteredLabels => GetFilteredRange().labels;
    private List<ChartSeries<double>> FilteredSeries => GetFilteredRange().series;

    /// <summary>
    /// X-axis labels for display: when there are more than ~14 points the time labels are thinned
    /// (intermediate ones blanked, keeping ~12 evenly spaced plus the last) so they don't overlap
    /// into an unreadable smear. The data points themselves are unchanged — only the axis labels are
    /// reduced. CSV export still uses the full <see cref="FilteredLabels"/>. TimeSeriesChart is only
    /// used for sequential time series, so thinning never hides a distinct category name.
    /// </summary>
    private string[] DisplayLabels
    {
        get
        {
            var labels = FilteredLabels;
            const int maxLabels = 14;
            if (labels.Length <= maxLabels)
                return labels;

            var step = (int)Math.Ceiling(labels.Length / 12.0);
            var last = labels.Length - 1;
            return labels.Select((label, i) => (i % step == 0 || i == last) ? label : string.Empty).ToArray();
        }
    }

    private (string[] labels, List<ChartSeries<double>> series) GetFilteredRange()
    {
        if (Labels.Length == 0 || Series.Count == 0)
            return ([], []);

        var count = SelectedPeriod switch
        {
            "3M" => 3,
            "6M" => 6,
            "12M" => 12,
            "24M" => 24,
            "36M" => 36,
            _ => Labels.Length,
        };

        if (count >= Labels.Length)
            return (Labels, Series);

        var skip = Labels.Length - count;
        var labels = Labels.Skip(skip).ToArray();
        var series = Series.Select(s => new ChartSeries<double>
        {
            Name = s.Name,
            Data = s.Data.Skip(skip).ToArray(),
        }).ToList();

        return (labels, series);
    }

    private async Task NotifyPeriodChanged()
    {
        if (OnPeriodChanged.HasDelegate)
            await OnPeriodChanged.InvokeAsync(new PeriodChangedArgs(SelectedPeriod, SelectedGranularity));
    }

    public record PeriodChangedArgs(string Period, Granularity Granularity);
    public enum Granularity { Monthly, Quarterly, Yearly }
}
