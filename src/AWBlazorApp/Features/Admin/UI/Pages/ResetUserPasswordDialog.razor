@using Microsoft.AspNetCore.Identity
@using AWBlazorApp.Features.Identity.Domain
@using AWBlazorApp.Features.Admin.Application
@inject UserManager<ApplicationUser> UserManager
@inject ISnackbar Snackbar

@* Admin-only password reset. Lives on the interactive /admin/users page, so MudBlazor inputs work
   here (unlike the static-SSR /Account/Manage/* forms). Resets without the user's current password
   via the shared AdminUserManagement helper, which rotates the security stamp. *@

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Reset password</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            Set a new password for <strong>@(Email ?? UserName ?? "this user")</strong>.
            This does not require their current password and will sign them out of any active sessions.
        </MudText>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="_newPassword"
                          Label="New password"
                          InputType="InputType.Password"
                          Required="true"
                          RequiredError="A new password is required."
                          Immediate="true" />
            <MudTextField @bind-Value="_confirmPassword"
                          Label="Confirm new password"
                          InputType="InputType.Password"
                          Required="true"
                          RequiredError="Please confirm the new password."
                          Validation="@(new Func<string, string?>(ConfirmMatches))"
                          Immediate="true"
                          Class="mt-2" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="@_saving">
            Reset password
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public string UserId { get; set; } = "";
    [Parameter] public string? Email { get; set; }
    [Parameter] public string? UserName { get; set; }

    private MudForm _form = default!;
    private string _newPassword = "";
    private string _confirmPassword = "";
    private bool _saving;

    private string? ConfirmMatches(string value)
        => value == _newPassword ? null : "Passwords do not match.";

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        await _form.Validate();
        if (!_form.IsValid) return;

        _saving = true;
        try
        {
            var user = await UserManager.FindByIdAsync(UserId);
            if (user is null)
            {
                Snackbar.Add("User no longer exists.", Severity.Error);
                MudDialog.Close(DialogResult.Cancel());
                return;
            }

            var result = await AdminUserManagement.ResetPasswordAsync(UserManager, user, _newPassword);
            if (result.Succeeded)
            {
                Snackbar.Add($"Password reset for {Email ?? UserName ?? user.UserName}.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add("Reset failed: " + string.Join("; ", result.Errors.Select(e => e.Description)), Severity.Error);
            }
        }
        finally
        {
            _saving = false;
        }
    }
}
