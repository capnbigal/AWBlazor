@page "/aw/work-orders/{Id:int}"
@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>Work order #@Id</PageTitle>

@if (loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (workOrder is null)
{
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" aria-label="Back" OnClick="@(() => Navigation.NavigateTo("aw/work-orders"))" />
            <MudText Typo="Typo.h5" HtmlTag="h1">Work order not found</MudText>
        </MudStack>
        <MudAlert Severity="Severity.Warning">
            No work order was found with id @Id.
        </MudAlert>
        <div>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.ArrowBack" Href="aw/work-orders">Back to list</MudButton>
        </div>
    </MudStack>
}
else
{
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" aria-label="Back" OnClick="@(() => Navigation.NavigateTo("aw/work-orders"))" />
            <MudText Typo="Typo.h5" HtmlTag="h1">Work order #@workOrder.Id</MudText>
            <MudChip T="string" Color="@StateColor" Variant="Variant.Filled">@StateLabel</MudChip>
            <MudSpacer />
            <MudButton Color="Color.Secondary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.History" Href="@($"aw/work-orders/history/{Id}")">View history</MudButton>
        </MudStack>

        <MudPaper Class="pa-3" Elevation="1">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    <MudField Label="Product" Variant="Variant.Text">
                        <MudLink Href="@($"aw/products/{workOrder.ProductId}")" Color="Color.Primary">@productName</MudLink>
                    </MudField>
                </MudItem>
                <MudItem xs="6" md="3"><MudField Label="Product id" Variant="Variant.Text">@workOrder.ProductId</MudField></MudItem>
                <MudItem xs="6" md="3"><MudField Label="Scrap reason" Variant="Variant.Text">@(scrapReasonName ?? "—")</MudField></MudItem>
                <MudItem xs="6" md="3"><MudField Label="Order qty" Variant="Variant.Text">@workOrder.OrderQty.ToString("N0")</MudField></MudItem>
                <MudItem xs="6" md="3"><MudField Label="Stocked qty" Variant="Variant.Text">@workOrder.StockedQty.ToString("N0")</MudField></MudItem>
                <MudItem xs="6" md="3"><MudField Label="Scrapped qty" Variant="Variant.Text">@workOrder.ScrappedQty.ToString("N0")</MudField></MudItem>
                <MudItem xs="6" md="3"><MudField Label="Duration" Variant="Variant.Text">@DurationText</MudField></MudItem>
                <MudItem xs="6" md="3"><MudField Label="Start date" Variant="Variant.Text">@workOrder.StartDate.ToString("yyyy-MM-dd")</MudField></MudItem>
                <MudItem xs="6" md="3"><MudField Label="Due date" Variant="Variant.Text">@workOrder.DueDate.ToString("yyyy-MM-dd")</MudField></MudItem>
                <MudItem xs="6" md="3"><MudField Label="End date" Variant="Variant.Text">@(workOrder.EndDate?.ToString("yyyy-MM-dd") ?? "In progress")</MudField></MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Class="pa-3" Elevation="1">
            <MudText Typo="Typo.h6">Routing steps (@routingSteps.Count)</MudText>
            @if (routingSteps.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Class="mt-2" Dense="true">No routing steps defined for this work order.</MudAlert>
            }
            else
            {
                <MudSimpleTable Dense="true" Hover="true" Striped="true" Class="mt-2">
                    <thead>
                        <tr>
                            <th>Seq</th>
                            <th>Location</th>
                            <th>Scheduled start</th>
                            <th>Scheduled end</th>
                            <th>Actual start</th>
                            <th>Actual end</th>
                            <th style="text-align:right">Hours</th>
                            <th style="text-align:right">Planned cost</th>
                            <th style="text-align:right">Actual cost</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in routingSteps)
                        {
                            <tr>
                                <td>@r.Sequence</td>
                                <td>@r.LocationName</td>
                                <td>@r.ScheduledStart.ToString("yyyy-MM-dd")</td>
                                <td>@r.ScheduledEnd.ToString("yyyy-MM-dd")</td>
                                <td>@(r.ActualStart?.ToString("yyyy-MM-dd") ?? "—")</td>
                                <td>@(r.ActualEnd?.ToString("yyyy-MM-dd") ?? "—")</td>
                                <td style="text-align:right">@(r.ActualHours?.ToString("N1") ?? "—")</td>
                                <td style="text-align:right">@r.PlannedCost.ToString("C2")</td>
                                <td style="text-align:right">@(r.ActualCost?.ToString("C2") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="7" style="text-align:right"><strong>Totals:</strong></td>
                            <td style="text-align:right"><strong>@routingSteps.Sum(r => r.PlannedCost).ToString("C2")</strong></td>
                            <td style="text-align:right"><strong>@routingSteps.Where(r => r.ActualCost.HasValue).Sum(r => r.ActualCost!.Value).ToString("C2")</strong></td>
                        </tr>
                    </tfoot>
                </MudSimpleTable>
            }
        </MudPaper>

        <RecordActivityTimeline Events="@activityEvents" Title="Activity" />

        <RelatedLinksCard Title="Related records" Links="@relatedLinks" />
    </MudStack>
}

@code {
    [Parameter] public int Id { get; set; }

    private bool loading = true;
    private WorkOrder? workOrder;
    private string productName = "";
    private string? scrapReasonName;
    private List<RoutingStepRow> routingSteps = [];
    private IReadOnlyList<ActivityEvent> activityEvents = [];
    private List<RelatedLink> relatedLinks = [];

    private string StateLabel => workOrder?.EndDate is null ? "In progress" : "Completed";
    private Color StateColor => workOrder?.EndDate is null ? Color.Info : Color.Success;

    private string DurationText
    {
        get
        {
            if (workOrder?.EndDate is null) return "In progress";
            var days = (workOrder.EndDate.Value - workOrder.StartDate).TotalDays;
            return $"{days:N0} days";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        workOrder = await db.WorkOrders.AsNoTracking().FirstOrDefaultAsync(w => w.Id == Id);
        if (workOrder is null)
        {
            loading = false;
            return;
        }

        var product = await db.Products.AsNoTracking().FirstOrDefaultAsync(p => p.Id == workOrder.ProductId);
        productName = product?.Name ?? $"Product {workOrder.ProductId}";

        if (workOrder.ScrapReasonId.HasValue)
        {
            scrapReasonName = await db.ScrapReasons.AsNoTracking()
                .Where(s => s.Id == workOrder.ScrapReasonId)
                .Select(s => s.Name)
                .FirstOrDefaultAsync();
        }

        activityEvents = RecordActivity.ForWorkOrder(workOrder.StartDate, workOrder.DueDate, workOrder.EndDate);

        relatedLinks =
        [
            new RelatedLink("Product: " + productName, $"aw/products/{workOrder.ProductId}", Icons.Material.Filled.Inventory2),
        ];

        var locations = await db.Locations.AsNoTracking().ToDictionaryAsync(l => l.Id, l => l.Name);
        var routings = await db.WorkOrderRoutings.AsNoTracking()
            .Where(r => r.WorkOrderId == Id)
            .OrderBy(r => r.OperationSequence)
            .ToListAsync();

        routingSteps = routings.Select(r => new RoutingStepRow
        {
            Sequence = r.OperationSequence,
            LocationName = locations.GetValueOrDefault(r.LocationId, $"Location {r.LocationId}"),
            ScheduledStart = r.ScheduledStartDate,
            ScheduledEnd = r.ScheduledEndDate,
            ActualStart = r.ActualStartDate,
            ActualEnd = r.ActualEndDate,
            ActualHours = r.ActualResourceHrs,
            PlannedCost = r.PlannedCost,
            ActualCost = r.ActualCost,
        }).ToList();

        loading = false;
    }

    private sealed class RoutingStepRow
    {
        public short Sequence { get; init; }
        public string LocationName { get; init; } = "";
        public DateTime ScheduledStart { get; init; }
        public DateTime ScheduledEnd { get; init; }
        public DateTime? ActualStart { get; init; }
        public DateTime? ActualEnd { get; init; }
        public decimal? ActualHours { get; init; }
        public decimal PlannedCost { get; init; }
        public decimal? ActualCost { get; init; }
    }
}
